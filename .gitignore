# Sensitive files
wp-config.php
.htaccess

# Uploads directory (bisa sangat besar)
wp-content/uploads/

# Cache directories
wp-content/cache/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php

# Log files
*.log
wp-content/debug.log

# Backup files
*.bak
*.backup
*.sql

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Node modules (jika ada)
node_modules/

# Composer — hanya root repo (vendor di dalam plugin WooCommerce harus ikut Git)
/vendor/

# Environment files
.env
.env.local
.env.production

# Temporary files
*.tmp
*.temp

# WordPress debug log
debug.log

# Hostinger specific
wp-content/ai1wm-backups/

# Theme admin images (to avoid deployment conflicts)
wp-content/themes/claue/core/admin/assets/images/layout/product-revamp.png

# Duplicate uploads folder (should never be tracked)
wp-content 2/
# Large archives
*.zip
*.gz
*.sql.gz

# Do not track WordPress core and marketplace plugins (server-managed)
wp-admin/
wp-includes/
wp-content/plugins/*
!wp-content/plugins/fuguku-gifts-post-type/
!wp-content/plugins/woocommerce/
wp-content/srplugin_backups/
wp-content/themes/twentytwentyfive/

# Stray/temporary items on server
fuguku_staging_*.sql.gz
router.php
claue/
wp-admin/wp-admin/

# Ignore ALL untracked vendor plugin files (specific patterns from deploy log)
wp-content/plugins/duplicate-page/
wp-content/plugins/elementor-pro/
wp-content/plugins/elementor/
wp-content/plugins/pojo-accessibility/
wp-content/plugins/srmehranclub_automatic_update/
